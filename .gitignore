!.env.example
*.key
*.pem
credentials*.json
neo4j_credentials*
*aura*.txt

# ============================================================
#  Environnements Python
# ============================================================
.venv/
venv/
env/
ENV/
conda-env/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ============================================================
