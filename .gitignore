# ============================================================
#  Corpus (47 Mo) - le PDF original reste hors du depot
# ============================================================
backend/data/raw/*.pdf
!backend/data/raw/PLACER_LE_PDF_ICI.md
documentation/*.pdf

# ============================================================
#  Artefacts generes par le pipeline
# ============================================================
backend/data/processed/*
backend/data/artifacts/*
!backend/data/processed/.gitkeep
!backend/data/artifacts/.gitkeep

# Index FAISS et tableaux numpy
*.index
*.faiss
*.npy
*.npz
*.pkl
*.joblib

# Fichiers volumineux generes
*.jsonl
*.parquet
*.log

# ============================================================
#  A CONSERVER dans le depot (preuves pour le rapport)
#  Les metriques calculees sont legeres et doivent etre versionnees.
# ============================================================
!backend/data/metrics/*.json
!backend/data/metrics/*.txt
!backend/eval/eval_set.json

