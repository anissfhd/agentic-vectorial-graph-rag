# ============================================================
#  Secrets - AUCUN identifiant ne doit jamais etre versionne
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
neo4j_credentials*
*aura*.txt

# ============================================================
#  Environnements Python
# ============================================================
.venv/
venv/
env/
ENV/
conda-env/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ============================================================
#  Frontend
# ============================================================
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-error.log*
.env.local
.env.development.local
.env.production.local

# ============================================================
#  Modeles telecharges et caches Hugging Face
# ============================================================
backend/data/hf_cache/
hf_cache/
.cache/
models/
*.safetensors
*.bin
*.onnx
nltk_data/

# ============================================================
#  Corpus - oeuvre tierce, jamais redistribuee
#  La these de Camille Cadiou reste hors du depot, ainsi que tout
#  artefact qui en reproduirait le texte integral.
# ============================================================
backend/data/raw/*.pdf
!backend/data/raw/PLACER_LE_PDF_ICI.md
documentation/*.pdf
documentation/specifications/

# Corpus nettoye et chunks : texte integral de la these -> exclus
backend/data/processed/*
!backend/data/processed/.gitkeep

# ============================================================
#  Caches, environnements et sorties de build
# ============================================================
backend/data/hf_cache/
frontend/dist/
frontend/node_modules/
.pytest_cache/

# Fichiers volumineux generes
*.jsonl
*.parquet
*.log

# ============================================================
#  A CONSERVER dans le depot : les preuves du rapport
#  Metriques calculees, artefacts du pipeline et jeu d'evaluation.
#  Tous sont legers et permettent de rejouer la demo sans le PDF.
# ============================================================
!backend/data/metrics/*.json
!backend/data/metrics/*.txt
!backend/data/metrics/*.png
!backend/data/metrics/*.md
!backend/eval/eval_set.json
!backend/eval/eval_set_review.md
!backend/data/artifacts/*.json
!backend/data/artifacts/*.npy
!backend/data/artifacts/*.index
!backend/data/artifacts/*.joblib
!backend/data/artifacts/graph.cypher
!backend/data/artifacts/graph.graphml

# ... sauf celui-ci : il contient le corpus complet tokenise.
# Cette ligne doit rester APRES les whitelists pour l'emporter.
# Le regenerer localement avec rebuild_artifacts.bat.
backend/data/artifacts/bm25_data.json

